# 앱 공개 URL (예: http://localhost:3000 또는 배포 도메인)
NEXT_PUBLIC_APP_URL=

# Supabase 프로젝트 URL (공개 가능)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (공개 가능 — RLS로 접근을 통제한다)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# 아래 값은 Phase 1에서 사용하지 않는다. 서버 전용 관리자/AI 기능이
# 실제로 추가될 때만 채운다. 절대 클라이언트 번들에 노출하지 않는다.
# ─────────────────────────────────────────────────────────────
# 서버 전용 관리자 스크립트에서만 사용 (교사 권한 수동 부여 등)
# SUPABASE_SERVICE_ROLE_KEY=
# AI_PROVIDER=
# AI_API_KEY=
