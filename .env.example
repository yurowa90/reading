# 앱 공개 URL (예: http://localhost:3000 또는 배포 도메인)
NEXT_PUBLIC_APP_URL=

# Supabase 프로젝트 URL (공개 가능)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (공개 가능 — RLS로 접근을 통제한다)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# 서버 전용 값. 절대 클라이언트 번들에 노출하지 않는다(NEXT_PUBLIC_ 금지).
# ─────────────────────────────────────────────────────────────

# 서버 전용 관리자 스크립트에서만 사용 (교사 권한 수동 부여 등)
# SUPABASE_SERVICE_ROLE_KEY=

# ── 독서 산파법 챗봇(Phase 5) ──────────────────────────────────
# AI_PROVIDER: gemini | mock  (미설정 시 AI_API_KEY 유무로 자동 결정)
# AI_API_KEY : 본인의 Google Gemini API 키 (https://aistudio.google.com/apikey)
#   * 서버 환경 변수에만 저장. 브라우저/클라이언트에 노출하지 않는다.
#   * 키가 없으면 안전한 예시(mock) 질문으로 동작한다.
# AI_MODEL   : 사용할 모델 (기본 gemini-flash-latest; 무료 등급 호출 가능 별칭)
# AI_PROVIDER=gemini
# AI_API_KEY=
# AI_MODEL=gemini-flash-latest
